                "background": "#b91c1c",
                "color": "#fff",
                "border": "1px solid #f87171",
                "fontWeight": "800"
              },
              "jsActions": [
                {
                  "id": "action-rts-enemy-advance",
                  "event": "click",
                  "enabled": true,
                  "stopPropagation": false,
                  "preventDefault": false,
                  "code": "builder.units.attackMove(\"rts-blue-01\", 430, 210);\nbuilder.units.attackMove(\"rts-blue-02\", 430, 250);\nbuilder.units.attackMove(\"rts-blue-03\", 400, 180);\nbuilder.units.attackMove(\"rts-blue-04\", 400, 290);\nbuilder.units.attackMove(\"rts-blue-05\", 380, 235);\nbuilder.units.attackMove(\"rts-blue-06\", 360, 235);\n\nbuilder.units.attackMove(\"rts-red-01\", 500, 210);\nbuilder.units.attackMove(\"rts-red-02\", 500, 250);\nbuilder.units.attackMove(\"rts-red-03\", 530, 180);\nbuilder.units.attackMove(\"rts-red-04\", 530, 290);\nbuilder.units.attackMove(\"rts-red-05\", 550, 235);\nbuilder.units.attackMove(\"rts-red-06\", 570, 235);"
                }
              ]
            },
