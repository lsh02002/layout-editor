          "children": [
            {
              "id": "rts-spawn",
              "name": "Spawn Mixed Army",
              "type": "button",
              "order": 0,
              "props": {
                "title": "SPAWN MIXED",
                "disabled": false,
                "action": {
                  "type": "none",
                  "payload": null
                }
              },
              "layout": {
                "widthMode": "auto",
                "positionParentId": null
              },
              "style": {
                "padding": "11px 18px",
                "borderRadius": "9px",
                "background": "#2563eb",
                "color": "#fff",
                "border": "1px solid #60a5fa",
                "fontWeight": "800"
              },
              "jsActions": [
                {
                  "id": "action-rts-spawn",
                  "event": "click",
                  "enabled": true,
                  "stopPropagation": false,
                  "preventDefault": false,
                  "code": "builder.units.clear();\n\nbuilder.units.spawn(\"rts-blue-01\", {\n  x: 80,\n  y: 120,\n  team: \"blue\",\n  unitClass: \"knight\",\n});\n\nbuilder.units.spawn(\"rts-blue-02\", {\n  x: 145,\n  y: 120,\n  team: \"blue\",\n  unitClass: \"knight\",\n});\n\nbuilder.units.spawn(\"rts-blue-03\", {\n  x: 80,\n  y: 210,\n  team: \"blue\",\n  unitClass: \"archer\",\n});\n\nbuilder.units.spawn(\"rts-blue-04\", {\n  x: 145,\n  y: 210,\n  team: \"blue\",\n  unitClass: \"archer\",\n});\n\nbuilder.units.spawn(\"rts-blue-05\", {\n  x: 210,\n  y: 165,\n  team: \"blue\",\n  unitClass: \"mage\",\n});\n\nbuilder.units.spawn(\"rts-blue-06\", {\n  x: 110,\n  y: 300,\n  team: \"blue\",\n  unitClass: \"tank\",\n});\n\nbuilder.units.spawn(\"rts-red-01\", {\n  x: 730,\n  y: 120,\n  team: \"red\",\n  unitClass: \"knight\",\n});\n\nbuilder.units.spawn(\"rts-red-02\", {\n  x: 795,\n  y: 120,\n  team: \"red\",\n  unitClass: \"knight\",\n});\n\nbuilder.units.spawn(\"rts-red-03\", {\n  x: 730,\n  y: 210,\n  team: \"red\",\n  unitClass: \"archer\",\n});\n\nbuilder.units.spawn(\"rts-red-04\", {\n  x: 795,\n  y: 210,\n  team: \"red\",\n  unitClass: \"archer\",\n});\n\nbuilder.units.spawn(\"rts-red-05\", {\n  x: 665,\n  y: 165,\n  team: \"red\",\n  unitClass: \"mage\",\n});\n\nbuilder.units.spawn(\"rts-red-06\", {\n  x: 765,\n  y: 300,\n  team: \"red\",\n  unitClass: \"tank\",\n});"
                }
              ]
            },
            {
              "id": "rts-enemy-advance",
              "name": "Force Battle",
              "type": "button",
              "order": 1,
              "props": {
                "title": "FORCE BATTLE",
                "disabled": false,
                "action": {
                  "type": "none",
                  "payload": null
