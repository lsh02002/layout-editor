                  "preventDefault": false,
                  "code": "builder.units.setFacing(\"rts-blue-01\", -1, 0);\nconst unit = document.querySelector('[data-runtime-unit-id=\"rts-blue-01\"]');\nif (unit) {\n  console.log(\"Blue Knight facing:\", unit.getAttribute(\"data-runtime-facing\"), unit.getAttribute(\"data-runtime-animation-state\"));\n}"
