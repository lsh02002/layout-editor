          "layout": {
            "widthMode": "fill",
            "positionParentId": null
          },
          "contentStyle": {
            "textAlign": "center",
            "color": "#a9b6d1"
          }
        },
        {
          "id": "rts-spawn-button-001",
          "name": "Spawn 12 Units",
          "type": "button",
          "order": 2,
          "props": {
            "title": "Spawn 12 Units",
            "disabled": false,
            "action": {
              "type": "none",
              "payload": null
            }
          },
          "layout": {
            "widthMode": "auto",
            "positionParentId": null
          },
          "style": {
            "padding": "10px 16px",
            "borderRadius": "8px"
          },
          "jsActions": [
            {
              "id": "rts-action-spawn-multi-001",
              "event": "click",
              "enabled": true,
              "stopPropagation": false,
              "preventDefault": false,
              "code": "builder.units.spawn(\n  \"rts-unit-001\",\n  { x: 90, y: 110, speed: 180, hp: 100 },\n);\n\nbuilder.units.spawn(\n  \"rts-unit-002\",\n  { x: 180, y: 110, speed: 180, hp: 100 },\n);\n\nbuilder.units.spawn(\n  \"rts-unit-003\",\n  { x: 270, y: 110, speed: 180, hp: 100 },\n);\n\nbuilder.units.spawn(\n  \"rts-unit-004\",\n  { x: 360, y: 110, speed: 180, hp: 100 },\n);\n\nbuilder.units.spawn(\n  \"rts-unit-005\",\n  { x: 90, y: 210, speed: 180, hp: 100 },\n);\n\nbuilder.units.spawn(\n  \"rts-unit-006\",\n  { x: 180, y: 210, speed: 180, hp: 100 },\n);\n\nbuilder.units.spawn(\n  \"rts-unit-007\",\n  { x: 270, y: 210, speed: 180, hp: 100 },\n);\n\nbuilder.units.spawn(\n  \"rts-unit-008\",\n  { x: 360, y: 210, speed: 180, hp: 100 },\n);\n\nbuilder.units.spawn(\n  \"rts-unit-009\",\n  { x: 90, y: 310, speed: 180, hp: 100 },\n);\n\nbuilder.units.spawn(\n  \"rts-unit-010\",\n  { x: 180, y: 310, speed: 180, hp: 100 },\n);\n\nbuilder.units.spawn(\n  \"rts-unit-011\",\n  { x: 270, y: 310, speed: 180, hp: 100 },\n);\n\nbuilder.units.spawn(\n  \"rts-unit-012\",\n  { x: 360, y: 310, speed: 180, hp: 100 },\n);"
            }
          ]
