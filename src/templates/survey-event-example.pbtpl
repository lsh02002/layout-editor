            {
              "id": "ra111111-1111-4111-8111-111111111111",
              "event": "change",
              "code": "const value = builder.getValue(\"r4333333-3333-4333-8333-333333333333\");\nif (value === \"블루\") {\n  builder.setStyle(\"r5000000-0000-4000-8000-000000000000\", \"border\", \"2px solid #0d6efd\");\n} else if (value === \"그린\") {\n  builder.setStyle(\"r5000000-0000-4000-8000-000000000000\", \"border\", \"2px solid #198754\");\n} else if (value === \"오렌지\") {\n  builder.setStyle(\"r5000000-0000-4000-8000-000000000000\", \"border\", \"2px solid #fd7e14\");\n} else {\n  builder.setStyle(\"r5000000-0000-4000-8000-000000000000\", \"border\", \"2px solid #6f42c1\");\n}",
