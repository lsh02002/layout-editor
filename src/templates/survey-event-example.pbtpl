          "jsActions": [
            {
              "id": "ra222222-2222-4222-8222-222222222222",
              "event": "click",
              "code": "const nickname = builder.getValue(\"r4222222-2222-4222-8222-222222222222\").trim();\nconst agree = builder.getChecked(\"r4666666-6666-4666-8666-666666666666\");\nif (!nickname) {\n  builder.focus(\"r4222222-2222-4222-8222-222222222222\");\n  return;\n}\nif (!agree) {\n  builder.setStyle(\"r4666666-6666-4666-8666-666666666666\", \"outline\", \"2px solid #dc3545\");\n  return;\n}\nbuilder.show(\"r5000000-0000-4000-8000-000000000000\");\nbuilder.setStyle(\"r5000000-0000-4000-8000-000000000000\", \"opacity\", \"1\");\nbuilder.scrollTo(\"r5000000-0000-4000-8000-000000000000\");",
              "enabled": true,
              "stopPropagation": false,
              "preventDefault": false,
              "targetComponentId": "r5000000-0000-4000-8000-000000000000"
            }
