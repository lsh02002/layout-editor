                "fontSize": "14px"
              }
            }
          ]
        },
        {
          "id": "control-row-1",
          "name": "Control Row 1",
          "type": "container",
          "order": 5,
          "props": {
            "direction": "row",
            "gap": 10,
            "justifyContent": "center",
            "alignItems": "stretch"
          },
          "layout": {
            "widthMode": "fill",
            "positionParentId": null
          },
          "style": {
            "width": "100%"
          },
          "children": [
            {
              "id": "btn-init",
              "name": "Initialize State",
              "type": "button",
              "order": 0,
              "props": {
                "title": "초기값 넣기",
                "disabled": false,
                "action": {
                  "type": "none",
                  "payload": null
                }
              },
              "layout": {
                "widthMode": "auto",
                "positionParentId": null
              },
              "style": {
                "padding": "11px 16px",
                "borderRadius": "8px"
              },
              "jsActions": [
                {
                  "id": "act-init",
                  "event": "click",
                  "code": "builder.state.set(\"score\", 10);\nbuilder.state.set(\"name\", \"홍길동\");\nbuilder.state.set(\"panelVisible\", true);",
                  "enabled": true,
                  "stopPropagation": false,
                  "preventDefault": false
                }
              ]
            },
            {
              "id": "btn-score-plus",
              "name": "Score Plus",
              "type": "button",
              "order": 1,
              "props": {
                "title": "score + 1",
                "disabled": false,
                "action": {
                  "type": "none",
                  "payload": null
                }
              },
              "layout": {
                "widthMode": "auto",
                "positionParentId": null
              },
              "style": {
                "padding": "11px 16px",
                "borderRadius": "8px"
              },
              "jsActions": [
                {
                  "id": "act-score-plus",
                  "event": "click",
                  "code": "builder.state.add(\"score\", 1);",
                  "enabled": true,
                  "stopPropagation": false,
                  "preventDefault": false
                }
              ]
            },
            {
              "id": "btn-score-minus",
              "name": "Score Minus",
              "type": "button",
              "order": 2,
              "props": {
                "title": "score - 1",
                "disabled": false,
                "action": {
                  "type": "none",
                  "payload": null
                }
              },
              "layout": {
                "widthMode": "auto",
                "positionParentId": null
              },
              "style": {
                "padding": "11px 16px",
                "borderRadius": "8px"
              },
              "jsActions": [
                {
                  "id": "act-score-minus",
                  "event": "click",
                  "code": "builder.state.add(\"score\", -1);",
                  "enabled": true,
                  "stopPropagation": false,
                  "preventDefault": false
                }
              ]
            }
          ]
        },
