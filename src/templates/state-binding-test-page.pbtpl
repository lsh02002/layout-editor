          "children": [
            {
              "id": "visible-box-title",
              "name": "Visible Box Title",
              "type": "heading",
              "order": 0,
              "props": {
                "text": "👀 visible 바인딩 영역",
                "level": 3
              },
              "layout": {
                "widthMode": "fill",
                "positionParentId": null
              },
              "contentStyle": {
                "textAlign": "center",
                "fontSize": "20px"
              }
            },
            {
              "id": "visible-box-desc",
              "name": "Visible Box Description",
              "type": "quill",
              "order": 1,
              "props": {
                "value": "<p>panelVisible이 false면 Preview에서 이 박스 전체가 사라져야 합니다.</p>",
