  "components": [
    {
      "id": "binding-root",
      "name": "State Binding Test",
      "type": "container",
      "order": 0,
      "props": {
        "direction": "column",
        "gap": 18,
        "justifyContent": "flex-start",
        "alignItems": "stretch"
      },
      "layout": {
