      "style": {
        "width": "100%",
        "maxWidth": "760px",
        "margin": "0 auto",
        "padding": "32px 24px",
        "boxSizing": "border-box"
      },
      "children": [
        {
          "id": "test-title",
          "name": "Test Title",
          "type": "heading",
          "order": 0,
          "props": {
            "text": "State Binding 테스트",
            "level": 1
          },
          "layout": {
            "widthMode": "fill",
            "positionParentId": null
          },
          "contentStyle": {
            "textAlign": "center",
            "fontSize": "34px"
          }
        },
        {
          "id": "test-desc",
          "name": "Instructions",
          "type": "quill",
          "order": 1,
          "props": {
            "value": "<p>Preview에서 아래 버튼을 눌러 <strong>text / value / visible</strong> 바인딩이 자동 반영되는지 확인하세요.</p>",
            "placeholder": "",
            "disabled": false
          },
          "layout": {
            "widthMode": "fill",
            "positionParentId": null
          },
          "style": {
            "width": "100%"
          },
          "contentStyle": {
            "textAlign": "center",
            "fontSize": "15px"
          }
        },
        {
          "id": "bound-score-heading",
          "name": "Bound Score Heading",
          "type": "heading",
          "order": 2,
          "props": {
            "text": "아직 score 없음",
            "level": 2
          },
          "stateBindings": [
            {
              "target": "text",
              "stateKey": "score"
            }
          ],
          "layout": {
            "widthMode": "fill",
            "positionParentId": null
          },
          "contentStyle": {
            "textAlign": "center",
            "fontSize": "28px"
          }
        },
        {
          "id": "bound-name-input",
          "name": "Bound Name Input",
          "type": "input",
          "order": 3,
          "props": {
            "value": "아직 name 없음",
            "inputType": "text",
            "placeholder": "",
            "name": "boundName",
            "disabled": true
          },
          "stateBindings": [
            {
              "target": "value",
              "stateKey": "name"
            }
          ],
          "layout": {
            "widthMode": "fill",
            "positionParentId": null
          },
          "style": {
            "width": "100%",
            "padding": "12px",
            "textAlign": "center",
            "borderRadius": "8px"
          }
        },
        {
          "id": "bound-visible-box",
          "name": "Bound Visible Box",
          "type": "container",
          "order": 4,
          "props": {
            "direction": "column",
            "gap": 8,
            "justifyContent": "center",
            "alignItems": "stretch"
          },
          "stateBindings": [
            {
              "target": "visible",
              "stateKey": "panelVisible"
            }
          ],
          "layout": {
            "widthMode": "fill",
            "positionParentId": null
          },
          "style": {
            "width": "100%",
            "padding": "20px",
            "boxSizing": "border-box",
            "border": "1px solid #cbd5e1",
