myDamage > 0) {\n  builder.state.add(\"playerHp\", -enemyDamage);\n}\n\nbuilder.state.add(\"mana\", 1);\n\nif (builder.state.get(\"mana\", 0) > 3) {\n  builder.state.set(\"mana\", 3);\n}\n\nbuilder.state.add(\"turn\", 1);\n\nconst currentTurn =\n  builder.state.get(\"turn\", 1);\n\nif (\n  builder.state.get(\"playerHp\", 0) <= 0 ||\n  currentTurn > 10\n) {\n  builder.setValue(\"player-hp-7e8cb0a7\", \"❤️ 내 체력: \" + builder.state.get(\"playerHp\", 0) + \" / 100\");\nbuilder.setValue(\"enemy-hp-d0a3e287\", \"👹 적 체력: \" + builder.state.get(\"enemyHp\", 0) + \" / 120\");\nbuilder.setValue(\"mana-8835003e\", \"🔷 마나: \" + builder.state.get(\"mana\", 0) + \" / 3\");\nbuilder.setValue(\"shield-3603b3e7\", \"🛡 방어막: \" + builder.state.get(\"shield\", 0));\nbuilder.setValue(\"turn-84c2ec6f\", \"⏳ 턴: \" + builder.state.get(\"turn\", 1) + \" / 10\");\nbuilder.setValue(\"combo-5d9627e1\", \"✨ 콤보: \" + builder.state.get(\"combo\", 0));\nbuilder.setValue(\"log-d070e4b8\", \"🔷 명상 사용 후 적의 반격! \" + (blocked > 0 ? \"방어 \" + blocked + \", \" : \"\") + \"피해 \" + enemyDamage);\n  await builder.delay(250);\n  builder.setStyle(\"battle-6238ec95\", \"opacity\", \"0\");\nbuilder.setStyle(\"battle-6238ec95\", \"pointer-events\", \"none\");\nbuilder.setStyle(\"battle-6238ec95\", \"z-index\", \"1\");\nbuilder.setStyle(\"lose-69d92104\", \"z-index\", \"2\");\nbuilder.setStyle(\"lose-69d92104\", \"pointer-events\", \"auto\");\nbuilder.setStyle(\"lose-69d92104\", \"opacity\", \"1\");\n  return;\n}\n\nbuilder.setValue(\"player-hp-7e8cb0a7\", \"❤️ 내 체력: \" + builder.state.get(\"playerHp\", 0) + \" / 100\");\nbuilder.setValue(\"enemy-hp-d0a3e287\", \"👹 적 체력: \" + builder.state.get(\"enemyHp\", 0) + \" / 120\");\nbuilder.setValue(\"mana-8835003e\", \"🔷 마나: \" + builder.state.get(\"mana\", 0) + \" / 3\");\nbuilder.setValue(\"shield-3603b3e7\", \"🛡 방어막: \" + builder.state.get(\"shield\", 0));\nbuilder.setValue(\"turn-84c2ec6f\", \"⏳ 턴: \" + builder.state.get(\"turn\", 1) + \" / 10\");\nbuilder.setValue(\"combo-5d9627e1\", \"✨ 콤보: \" + builder.state.get(\"combo\", 0));\nbuilder.setValue(\"log-d070e4b8\", \"🔷 명상 사용 → 적 반격! \" + (blocked > 0 ? \"방어 \" + blocked + \", \" : \"\") + \"피해 \" + enemyDamage);",
