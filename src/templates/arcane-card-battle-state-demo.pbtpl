                  "jsActions": [
                    {
                      "id": "action-a4ff878c",
                      "event": "click",
                      "code": "const manaBefore = builder.state.get(\"mana\", 0);\n\nif (manaBefore < 0) {\n  builder.setValue(\"log-d070e4b8\", \"마나가 부족합니다. 필요한 마나: 0\");\n  return;\n}\n\nbuilder.state.add(\"mana\", -0);\n\nbuilder.state.add(\"enemyHp\", -12);\n\nconst lastCard =\n  builder.state.get(\"lastCard\", \"\");\n\nif (lastCard === \"strike\") {\n  builder.state.add(\"combo\", 1);\n  builder.state.add(\"enemyHp\", -4);\n} else {\n  builder.state.set(\"combo\", 1);\n}\n\nbuilder.state.set(\"lastCard\", \"strike\");\n\nif (builder.state.get(\"enemyHp\", 0) <= 0) {\n  builder.setValue(\"player-hp-7e8cb0a7\", \"❤️ 내 체력: \" + builder.state.get(\"playerHp\", 0) + \" / 100\");\nbuilder.setValue(\"enemy-hp-d0a3e287\", \"👹 적 체력: \" + builder.state.get(\"enemyHp\", 0) + \" / 120\");\nbuilder.setValue(\"mana-8835003e\", \"🔷 마나: \" + builder.state.get(\"mana\", 0) + \" / 3\");\nbuilder.setValue(\"shield-3603b3e7\", \"🛡 방어막: \" + builder.state.get(\"shield\", 0));\nbuilder.setValue(\"turn-84c2ec6f\", \"⏳ 턴: \" + builder.state.get(\"turn\", 1) + \" / 10\");\nbuilder.setValue(\"combo-5d9627e1\", \"✨ 콤보: \" + builder.state.get(\"combo\", 0));\nbuilder.setValue(\"log-d070e4b8\", \"⚔ 베기 사용! 적을 쓰러뜨렸습니다.\");\n  await builder.delay(250);\n  builder.setStyle(\"battle-6238ec95\", \"opacity\", \"0\");\nbuilder.setStyle(\"battle-6238ec95\", \"pointer-events\", \"none\");\nbuilder.setStyle(\"battle-6238ec95\", \"z-index\", \"1\");\nbuilder.setStyle(\"win-685f628d\", \"z-index\", \"2\");\nbuilder.setStyle(\"win-685f628d\", \"pointer-events\", \"auto\");\nbuilder.setStyle(\"win-685f628d\", \"opacity\", \"1\");\n  return;\n}\n\nlet enemyDamage =\n  8 + Math.floor(Math.random() * 9);\n\nif (builder.state.get(\"enemyHp\", 0) <= 35) {\n  enemyDamage += 5;\n}\n\nlet shield =\n  builder.state.get(\"shield\", 0);\n\nconst blocked =\n  Math.min(shield, enemyDamage);\n\nshield -= blocked;\nenemyDamage -= blocked;\n\nbuilder.state.set(\"shield\", shield);\n\nif (enemyDamage > 0) {\n  builder.state.add(\"playerHp\", -enemyDamage);\n}\n\nbuilder.state.add(\"mana\", 1);\n\nif (builder.state.get(\"mana\", 0) > 3) {\n  builder.state.set(\"mana\", 3);\n}\n\nbuilder.state.add(\"turn\", 1);\n\nconst currentTurn =\n  builder.state.get(\"turn\", 1);\n\nif (\n  builder.state.get(\"playerHp\", 0) <= 0 ||\n  currentTurn > 10\n) {\n  builder.setValue(\"player-hp-7e8cb0a7\", \"❤️ 내 체력: \" + builder.state.get(\"playerHp\", 0) + \" / 100\");\nbuilder.setValue(\"enemy-hp-d0a3e287\", \"👹 적 체력: \" + builder.state.get(\"enemyHp\", 0) + \" / 120\");\nbuilder.setValue(\"mana-8835003e\", \"🔷 마나: \" + builder.state.get(\"mana\", 0) + \" / 3\");\nbuilder.setValue(\"shield-3603b3e7\", \"🛡 방어막: \" + builder.state.get(\"shield\", 0));\nbuilder.setValue(\"turn-84c2ec6f\", \"⏳ 턴: \" + builder.state.get(\"turn\", 1) + \" / 10\");\nbuilder.setValue(\"combo-5d9627e1\", \"✨ 콤보: \" + builder.state.get(\"combo\", 0));\nbuilder.setValue(\"log-d070e4b8\", \"⚔ 베기 사용 후 적의 반격! \" + (blocked > 0 ? \"방어 \" + blocked + \", \" : \"\") + \"피해 \" + enemyDamage);\n  await builder.delay(250);\n  builder.setStyle(\"battle-6238ec95\", \"opacity\", \"0\");\nbuilder.setStyle(\"battle-6238ec95\", \"pointer-events\", \"none\");\nbuilder.setStyle(\"battle-6238ec95\", \"z-index\", \"1\");\nbuilder.setStyle(\"lose-69d92104\", \"z-index\", \"2\");\nbuilder.setStyle(\"lose-69d92104\", \"pointer-events\", \"auto\");\nbuilder.setStyle(\"lose-69d92104\", \"opacity\", \"1\");\n  return;\n}\n\nbuilder.setValue(\"player-hp-7e8cb0a7\", \"❤️ 내 체력: \" + builder.state.get(\"playerHp\", 0) + \" / 100\");\nbuilder.setValue(\"enemy-hp-d0a3e287\", \"👹 적 체력: \" + builder.state.get(\"enemyHp\", 0) + \" / 120\");\nbuilder.setValue(\"mana-8835003e\", \"🔷 마나: \" + builder.state.get(\"mana\", 0) + \" / 3\");\nbuilder.setValue(\"shield-3603b3e7\", \"🛡 방어막: \" + builder.state.get(\"shield\", 0));\nbuilder.setValue(\"turn-84c2ec6f\", \"⏳ 턴: \" + builder.state.get(\"turn\", 1) + \" / 10\");\nbuilder.setValue(\"combo-5d9627e1\", \"✨ 콤보: \" + builder.state.get(\"combo\", 0));\nbuilder.setValue(\"log-d070e4b8\", \"⚔ 베기 사용 → 적 반격! \" + (blocked > 0 ? \"방어 \" + blocked + \", \" : \"\") + \"피해 \" + enemyDamage);",
