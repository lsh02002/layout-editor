                    {
                      "id": "action-d05414ca",
                      "event": "click",
                      "code": "builder.state.add(\"money\", -25);\nbuilder.state.add(\"population\", 0);\nbuilder.state.add(\"food\", 35);\nbuilder.state.add(\"happiness\", 2);\n\nbuilder.state.add(\"turn\", 1);\n\nconst currentTurn = builder.state.get(\"turn\", 1);\n\n// 매 4턴 유지비: 인구에 따라 식량 소비\nif ((currentTurn - 1) % 4 === 0) {\n  const upkeep = Math.max(5, Math.floor(builder.state.get(\"population\", 0) / 8));\n  builder.state.add(\"food\", -upkeep);\n}\n\nbuilder.setValue(\"money-b973cf91\", \"💰 자금: \" + builder.state.get(\"money\", 0));\nbuilder.setValue(\"population-26dd6263\", \"👥 인구: \" + builder.state.get(\"population\", 0));\nbuilder.setValue(\"food-172bd344\", \"🌾 식량: \" + builder.state.get(\"food\", 0));\nbuilder.setValue(\"happiness-0f7c6ec7\", \"😊 행복도: \" + builder.state.get(\"happiness\", 0));\nbuilder.setValue(\"turn-64a4838e\", \"📅 턴: \" + builder.state.get(\"turn\", 1) + \" / 12\");\nbuilder.setValue(\"log-038a8cac\", \"농장을 확장했습니다. 식량 +35, 자금 -25\");\nconst money = builder.state.get(\"money\", 0);\nconst population = builder.state.get(\"population\", 0);\nconst food = builder.state.get(\"food\", 0);\nconst happiness = builder.state.get(\"happiness\", 0);\nconst turn = builder.state.get(\"turn\", 1);\n\nif (money < 0 || food < 0 || happiness <= 0 || population <= 0) {\n  await builder.delay(250);\n  builder.setStyle(\"game-ee1d4908\", \"opacity\", \"0\");\nbuilder.setStyle(\"game-ee1d4908\", \"pointer-events\", \"none\");\nbuilder.setStyle(\"game-ee1d4908\", \"z-index\", \"1\");\nbuilder.setStyle(\"lose-329e8e3e\", \"z-index\", \"2\");\nbuilder.setStyle(\"lose-329e8e3e\", \"pointer-events\", \"auto\");\nbuilder.setStyle(\"lose-329e8e3e\", \"opacity\", \"1\");\n} else if (turn > 12) {\n  await builder.delay(250);\n\n  if (population >= 90 && happiness >= 55 && money >= 120) {\n    builder.setStyle(\"game-ee1d4908\", \"opacity\", \"0\");\nbuilder.setStyle(\"game-ee1d4908\", \"pointer-events\", \"none\");\nbuilder.setStyle(\"game-ee1d4908\", \"z-index\", \"1\");\nbuilder.setStyle(\"win-db783719\", \"z-index\", \"2\");\nbuilder.setStyle(\"win-db783719\", \"pointer-events\", \"auto\");\nbuilder.setStyle(\"win-db783719\", \"opacity\", \"1\");\n  } else {\n    builder.setStyle(\"game-ee1d4908\", \"opacity\", \"0\");\nbuilder.setStyle(\"game-ee1d4908\", \"pointer-events\", \"none\");\nbuilder.setStyle(\"game-ee1d4908\", \"z-index\", \"1\");\nbuilder.setStyle(\"lose-329e8e3e\", \"z-index\", \"2\");\nbuilder.setStyle(\"lose-329e8e3e\", \"pointer-events\", \"auto\");\nbuilder.setStyle(\"lose-329e8e3e\", \"opacity\", \"1\");\n  }\n}",
