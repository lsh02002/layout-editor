          "jsActions": [
            {
              "id": "c1111111-1111-4111-8111-111111111111",
              "event": "change",
              "code": "if (builder.getChecked(\"b7777777-7777-4777-8777-777777777777\")) {\n  builder.setStyle(\"a4444444-4444-4444-8444-444444444444\", \"border\", \"2px solid #198754\");\n  builder.setStyle(\"a4444444-4444-4444-8444-444444444444\", \"opacity\", \"1\");\n} else {\n  builder.setStyle(\"a4444444-4444-4444-8444-444444444444\", \"border\", \"1px solid #0dcaf0\");\n  builder.setStyle(\"a4444444-4444-4444-8444-444444444444\", \"opacity\", \"0.65\");\n}",
              "enabled": true,
              "stopPropagation": false,
              "preventDefault": false,
              "targetComponentId": "a4444444-4444-4444-8444-444444444444"
            }
          ]
