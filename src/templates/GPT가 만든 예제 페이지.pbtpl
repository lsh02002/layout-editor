        {
          "id": "b8888888-8888-4888-8888-888888888888",
          "name": "Check Application",
          "type": "alert",
          "order": 7,
          "props": {
            "message": "입력 완료 후 여기를 클릭해서 신청 내용을 확인하세요.",
            "variant": "success",
            "dismissible": false
          },
          "layout": {
            "widthMode": "fill",
            "positionParentId": null
          },
          "style": {
            "width": "100%",
            "margin": "0",
            "cursor": "pointer"
          },
          "jsActions": [
            {
              "id": "c2222222-2222-4222-8222-222222222222",
              "event": "click",
              "code": "const name = builder.getValue(\"b2222222-2222-4222-8222-222222222222\").trim();\nconst email = builder.getValue(\"b3333333-3333-4333-8333-333333333333\").trim();\nconst region = builder.getValue(\"b4444444-4444-4444-8444-444444444444\");\nconst agreed = builder.getChecked(\"b7777777-7777-4777-8777-777777777777\");\n\nif (!name) {\n  builder.setStyle(\"b2222222-2222-4222-8222-222222222222\", \"outline\", \"2px solid #dc3545\");\n  builder.focus(\"b2222222-2222-4222-8222-222222222222\");\n  return;\n}\n\nif (!email) {\n  builder.setStyle(\"b3333333-3333-4333-8333-333333333333\", \"outline\", \"2px solid #dc3545\");\n  builder.focus(\"b3333333-3333-4333-8333-333333333333\");\n  return;\n}\n\nif (!agreed) {\n  builder.setStyle(\"b7777777-7777-4777-8777-777777777777\", \"outline\", \"2px solid #dc3545\");\n  builder.scrollTo(\"b7777777-7777-4777-8777-777777777777\");\n  return;\n}\n\nbuilder.setStyle(\"b0000000-0000-4000-8000-000000000000\", \"border\", \"2px solid #198754\");\nbuilder.setStyle(\"b0000000-0000-4000-8000-000000000000\", \"box-shadow\", \"0 0 0 4px rgba(25,135,84,0.12)\");\nbuilder.setStyle(\"b8888888-8888-4888-8888-888888888888\", \"opacity\", \"0.55\");\nbuilder.setAttribute(\"b0000000-0000-4000-8000-000000000000\", \"data-selected-region\", region);\nbuilder.scrollTo(\"b0000000-0000-4000-8000-000000000000\");",
              "enabled": true,
              "stopPropagation": false,
              "preventDefault": false,
              "targetComponentId": "b0000000-0000-4000-8000-000000000000"
            }
          ]
        }
      ]
    },
    {
      "id": "d1111111-1111-4111-8111-111111111111",
      "name": "Interaction Guide",
      "type": "quill",
      "order": 5,
      "props": {
        "value": "<p><strong>미리보기 테스트</strong></p><p>1. 이름과 이메일을 입력합니다.</p><p>2. 지역과 경험을 선택합니다.</p><p>3. 동의를 체크하면 상단 안내 박스가 강조됩니다.</p><p>4. 초록색 안내 박스를 클릭하면 입력 상태를 검사하고 폼 테두리가 변경됩니다.</p>",
        "placeholder": "본문을 입력하세요.",
        "disabled": false
      },
      "layout": {
        "widthMode": "fill",
        "positionParentId": null
      },
