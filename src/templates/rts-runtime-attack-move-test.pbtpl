              "style": {
                "padding": "11px 18px",
                "borderRadius": "9px",
                "background": "#2563eb",
                "color": "#fff",
                "border": "1px solid #60a5fa",
                "fontWeight": "800"
              },
              "jsActions": [
                {
                  "id": "action-rts-spawn",
                  "event": "click",
                  "enabled": true,
                  "stopPropagation": false,
                  "preventDefault": false,
                  "code": "builder.units.clear();\n\nbuilder.units.spawn(\"rts-blue-01\", {\n  x: 90,\n  y: 130,\n  speed: 170,\n  hp: 140,\n  team: \"blue\",\n  attackDamage: 18,\n  attackRange: 78,\n  attackCooldown: 650,\n  aggroRange: 240,\n});\n\nbuilder.units.spawn(\"rts-blue-02\", {\n  x: 165,\n  y: 130,\n  speed: 170,\n  hp: 140,\n  team: \"blue\",\n  attackDamage: 18,\n  attackRange: 78,\n  attackCooldown: 650,\n  aggroRange: 240,\n});\n\nbuilder.units.spawn(\"rts-blue-03\", {\n  x: 240,\n  y: 130,\n  speed: 170,\n  hp: 140,\n  team: \"blue\",\n  attackDamage: 18,\n  attackRange: 78,\n  attackCooldown: 650,\n  aggroRange: 240,\n});\n\nbuilder.units.spawn(\"rts-blue-04\", {\n  x: 90,\n  y: 215,\n  speed: 170,\n  hp: 140,\n  team: \"blue\",\n  attackDamage: 18,\n  attackRange: 78,\n  attackCooldown: 650,\n  aggroRange: 240,\n});\n\nbuilder.units.spawn(\"rts-blue-05\", {\n  x: 165,\n  y: 215,\n  speed: 170,\n  hp: 140,\n  team: \"blue\",\n  attackDamage: 18,\n  attackRange: 78,\n  attackCooldown: 650,\n  aggroRange: 240,\n});\n\nbuilder.units.spawn(\"rts-blue-06\", {\n  x: 240,\n  y: 215,\n  speed: 170,\n  hp: 140,\n  team: \"blue\",\n  attackDamage: 18,\n  attackRange: 78,\n  attackCooldown: 650,\n  aggroRange: 240,\n});\n\nbuilder.units.spawn(\"rts-red-01\", {\n  x: 630,\n  y: 300,\n  speed: 145,\n  hp: 120,\n  team: \"red\",\n  attackDamage: 14,\n  attackRange: 72,\n  attackCooldown: 750,\n  aggroRange: 220,\n});\n\nbuilder.units.spawn(\"rts-red-02\", {\n  x: 705,\n  y: 300,\n  speed: 145,\n  hp: 120,\n  team: \"red\",\n  attackDamage: 14,\n  attackRange: 72,\n  attackCooldown: 750,\n  aggroRange: 220,\n});\n\nbuilder.units.spawn(\"rts-red-03\", {\n  x: 780,\n  y: 300,\n  speed: 145,\n  hp: 120,\n  team: \"red\",\n  attackDamage: 14,\n  attackRange: 72,\n  attackCooldown: 750,\n  aggroRange: 220,\n});\n\nbuilder.units.spawn(\"rts-red-04\", {\n  x: 630,\n  y: 385,\n  speed: 145,\n  hp: 120,\n  team: \"red\",\n  attackDamage: 14,\n  attackRange: 72,\n  attackCooldown: 750,\n  aggroRange: 220,\n});\n\nbuilder.units.spawn(\"rts-red-05\", {\n  x: 705,\n  y: 385,\n  speed: 145,\n  hp: 120,\n  team: \"red\",\n  attackDamage: 14,\n  attackRange: 72,\n  attackCooldown: 750,\n  aggroRange: 220,\n});\n\nbuilder.units.spawn(\"rts-red-06\", {\n  x: 780,\n  y: 385,\n  speed: 145,\n  hp: 120,\n  team: \"red\",\n  attackDamage: 14,\n  attackRange: 72,\n  attackCooldown: 750,\n  aggroRange: 220,\n});"
